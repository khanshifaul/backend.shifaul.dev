# Application
NODE_ENV=development
# NODE_ENV=production
PORT=4000

# Swagger
SWAGGER_ENABLED=true

# Logging
LOG_LEVEL=debug #info

# Database
DATABASE_CLEANING_ENABLED=false
DATABASE_URL="file:./dev.db"
# MONGODB_URL="mongodb://localhost:27017/shifaul_dev"

# URLs
FRONTEND_URL=https://shifaul.dev
BACKEND_URL=https://backend.shifaul.dev
CORS_ORIGIN=https://shifaul.dev,https://backend.shifaul.dev,http://localhost:4173,http://localhost:4000,http://192.168.0.180:4000,http://localhost:5173,https://dev.shifaul.dev,https://backend.dev.shifaul.dev

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://shifaul.dev/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://shifaul.dev/api/auth/github/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://shifaul.dev/api/auth/facebook/callback

# JWT
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=1d
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_REFRESH_TOKEN_REMEMBER_ME_EXPIRES_IN=30d
JWT_EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=1d
JWT_PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Throttling
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_PUBLIC_URL=

# ============================================================
# AI ASSISTANT (RAG) — split providers
# Chat:    OPENAI_BASE_URL + OPENAI_API_KEY (default: Kilo Gateway)
# Embed:   OPENAI_EMBEDDING_BASE_URL + OPENAI_EMBEDDING_API_KEY (falls back to chat creds)
# ============================================================
# The chat client and embedding client can point at different providers. Useful
# when a free tier supports only one of them.
#
# Kilo Gateway (current production):
#   OPENAI_BASE_URL=https://api.kilo.ai/api/gateway
#   OPENAI_CHAT_MODEL=poolside/laguna-s-2.1:free           # clean output, no reasoning leak
#
# NVIDIA NIM for embeddings (free):
#   OPENAI_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b     # 2048-dim
#
# Other providers (single-provider setups work too):
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1            (chat only — no embeddings)
#   Together:   https://api.together.xyz/v1               (chat + embeddings)
#   Ollama:     http://localhost:11434/v1                 (chat + embeddings, local)
#
# ⚠️  If you switch embedding providers, delete existing chunks first:
#   bunx tsx src/ai-assistant/ingestion/seed.ts          # wipes + re-embeds automatically
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.kilo.ai/api/gateway
OPENAI_CHAT_MODEL=poolside/laguna-s-2.1:free
OPENAI_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# ============================================================
# TELEGRAM NOTIFIER (real contact-request delivery)
# ============================================================
# When the AI assistant detects that a visitor wants to be contacted or
# pass a message to Shifaul, OR when someone submits the contact form at
# shifaul.dev/contact, a Telegram message is sent automatically.
#
# Setup:
#   1. Telegram → @BotFather → /newbot → follow prompts → copy token
#   2. Send any message to your new bot (this registers your chat_id)
#   3. GET https://api.telegram.org/bot<TOKEN>/getUpdates
#      → find "chat":{"id": <number>,...} in the response
#   4. Paste values below.
#
# Leave blank to disable — contact requests will still be saved to the DB
# but won't be delivered.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
